{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --no-audit --no-fund --loglevel=error",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/Front-Vende-Lote/browser",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
